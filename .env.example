APP_ENV=local
DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobs
# Tests reset this disposable database. Its name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobs_test
CORS_ORIGINS=http://localhost:3000

# Live search (in-memory, single process)
SEARCH_STATE_TTL_MINUTES=60
SEARCH_MAX_STATES=200
SEARCH_MAX_ITEMS=100000
SEARCH_EVICTION_INTERVAL_SECONDS=60
HIMALAYAS_CONCURRENCY=12
HIMALAYAS_TIMEOUT_SECONDS=20

# Multi-provider live search (defaults enable himalayas, remoteok, jobicy)
# Example: disable one provider without code changes
# PROVIDER_CONFIG_JSON={"jobicy":{"enabled":false}}
# When SEARCH_MAX_ITEMS and SEARCH_MAX_STATES use defaults (100000/200), effective
# caps scale down by enabled provider count to preserve warm-index headroom.
